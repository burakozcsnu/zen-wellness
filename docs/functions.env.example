# Edge Function secrets for send-schedule-reminders. See docs/local-setup.md.
# Copy this file to "supabase/.env.functions" (git ignores it) and fill in the values.
# Every line in that file is uploaded as-is: fill every value or delete the line.
# Names starting with SUPABASE_ are reserved; Supabase provides them automatically.

# Contact address shown to push services (mailto: or https: URL)
VAPID_SUBJECT=mailto:you@example.com

# Public key: must equal VAPID_PUBLIC_KEY in script.js
VAPID_PUBLIC_KEY=

# Private key: must belong to the public key above
VAPID_PRIVATE_KEY=

# Must equal the Bearer value in the pg_cron job "send-schedule-reminders"
CRON_SECRET=

# Supabase > Project Settings > API Keys > Secret keys (starts with sb_secret_)
DATABASE_SECRET_KEY=
