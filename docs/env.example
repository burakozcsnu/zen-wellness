# Local secrets for scripts (backup, future tests). See docs/local-setup.md.
# Copy this file to ".env" in the repository folder (git ignores .env) and fill in the values.
# Never commit, paste or share the filled-in file.
# If a value contains # or spaces, wrap it in single quotes: KEY='value'

# Database password (Supabase > Project Settings > Database)
SUPABASE_DB_PASSWORD=

# Trainer (admin) login, used by the backup to download document files
ZEN_TRAINER_EMAIL=
ZEN_TRAINER_PASSWORD=

# Test client login (a client account, never a real client), used by scripts/check-member-permissions.js
ZEN_TEST_CLIENT_EMAIL=
ZEN_TEST_CLIENT_PASSWORD=
